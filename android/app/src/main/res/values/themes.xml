<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Jetpack Compose. -->
    <style name="Theme.CentreYouth" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Seamless dark cosmic launch window (no bare static logo) handing off straight to 3D Animated Entry -->
    <style name="Theme.CentreYouth.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/startup_cosmic</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowBackground">@color/startup_cosmic</item>
        <item name="postSplashScreenTheme">@style/Theme.CentreYouth</item>
    </style>
</resources>
