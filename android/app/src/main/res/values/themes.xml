<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Jetpack Compose. -->
    <style name="Theme.CentreYouth" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.CentreYouth.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CentreYouth</item>
    </style>
</resources>
